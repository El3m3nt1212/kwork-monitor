@echo off
rem Ручной запуск монитора с выводом в консоль.
rem Планировщик Windows запускает не этот файл, а pythonw.exe run_once.py — без окна
rem консоли, чтобы каждые полчаса не мигало поверх всех окон и не сворачивало
rem полноэкранные приложения. Лог пишет сам скрипт (см. run_once._setup_output).
cd /d "%~dp0"
python run_once.py %*
